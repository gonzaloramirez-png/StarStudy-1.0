# ========================================
# StarStudy - Variables de entorno (ejemplo)
# ========================================
# Copia este archivo a .env y modifica los valores
# NO comites .env real (está en .gitignore)
# ========================================

# ----------------------------------------
# Django Core
# ----------------------------------------
DEBUG=False
SECRET_KEY=tu-clave-secreta-muy-larga-y-aleatoria-aqui-generada-con-python-secrets
ALLOWED_HOSTS=starstudy.tudominio.com,www.starstudy.tudominio.com
CSRF_TRUSTED_ORIGINS=https://starstudy.tudominio.com,https://www.starstudy.tudominio.com

# ----------------------------------------
# Base de datos (docker-compose usa variables individuales)
# ----------------------------------------
# OPCIÓN A: DATABASE_URL (Render, Railway, Heroku, etc.)
# DATABASE_URL=postgres://usuario:password@host:5432/nombre_bd

# OPCIÓN B: Variables individuales (docker-compose)
DB_ENGINE=postgresql
DB_NAME=starstudy
DB_USER=starstudy
DB_PASSWORD=cambia_esta_password_segura
DB_HOST=db
DB_PORT=5432

# ----------------------------------------
# Redis / Celery
# ----------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ----------------------------------------
# Email (SMTP real para producción)
# ----------------------------------------
EMAIL_HOST=smtp.tu-proveedor.com
EMAIL_PORT=587
EMAIL_HOST_USER=tu-usuario-smtp
EMAIL_HOST_PASSWORD=tu-password-smtp
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=StarStudy <noreply@starstudy.tudominio.com>

# ----------------------------------------
# Seguridad extra
# ----------------------------------------
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# ----------------------------------------
# Fernet key (para tokens GitHub OAuth)
# Generar: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ----------------------------------------
FERNET_KEY=tu-fernet-key-base64-aqui

# ----------------------------------------
# Superusuario automático (primer deploy)
# ----------------------------------------
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@starstudy.tudominio.com
DJANGO_SUPERUSER_PASSWORD=password-super-seguro-cambialo-despues

# ----------------------------------------
# Timezone / Locale
# ----------------------------------------
TIME_ZONE=America/Argentina/Buenos_Aires
LANGUAGE_CODE=es